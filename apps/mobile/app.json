{
  "expo": {
    "name": "CodeBridge",
    "slug": "codebridge",
    "scheme": "codebridge",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0E14",
    "ios": {
      "bundleIdentifier": "dev.codebridge.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CodeBridge uses the camera only to scan the pairing QR code shown by your Mac."
      }
    },
    "android": {
      "package": "dev.codebridge.app",
      "permissions": ["CAMERA"],
      "allowBackup": false
    },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "CodeBridge uses the camera only to scan the pairing QR code shown by your Mac.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiUrl": "http://localhost:8080"
    }
  }
}
