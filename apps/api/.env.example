# Copy to .env for local development. Never commit real values.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgres://codebridge:codebridge@localhost:5432/codebridge
# Public base URL the Mac agent and mobile app use (https:// in production).
PUBLIC_URL=http://localhost:8080
# 32-byte key, base64. Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_KEY_VERSION=1
# Comma-separated origins allowed by CORS (the Expo web dev server, if used).
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=info
# Set to true when running behind a TLS-terminating reverse proxy.
TRUST_PROXY=false
# Managed cloud sessions (CodeBridge-managed Anthropic Managed Agents sessions).
CLOUD_SESSIONS_ENABLED=true
CLOUD_DEFAULT_MODEL=claude-opus-5-5
CLOUD_DEFAULT_BUDGET_CENTS=500
CLOUD_MAX_CONCURRENT=2
CLOUD_MAX_SESSION_MINUTES=120
