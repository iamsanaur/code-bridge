{
  "name": "@codebridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@codebridge/protocol": "workspace:*",
    "@codebridge/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "ws": "^8.18.0"
  }
}
