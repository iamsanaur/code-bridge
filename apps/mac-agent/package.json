{
  "name": "codebridge-agent",
  "version": "0.4.5",
  "type": "module",
  "bin": {
    "codebridge-agent": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts run",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "prepack": "pnpm run bundle"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.1.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codebridge/protocol": "workspace:*",
    "@codebridge/shared": "workspace:*",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "description": "CodeBridge agent: run and supervise coding sessions on your own Mac or Windows PC from your phone.",
  "keywords": [
    "codebridge",
    "claude-code",
    "remote",
    "coding-agent",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamsanaur/code-bridge.git",
    "directory": "apps/mac-agent"
  },
  "homepage": "https://github.com/iamsanaur/code-bridge#readme",
  "bugs": {
    "url": "https://github.com/iamsanaur/code-bridge/issues"
  }
}
